rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> HIER dieselbe E-Mail eintragen wie in firebase-config.js <<<
    function isStaff() {
      return request.auth != null
        && request.auth.token.email == 'personal@meinverein.de';
    }

    // Vereinsname, Begrüßung, Kategorien: jeder darf lesen, nur Personal ändern
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Speisekarte: jeder darf lesen, nur Personal ändern
    match /items/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Fortlaufende Bestellnummer: Gäste dürfen nur um genau 1 hochzählen
    match /counters/orders {
      allow read: if true;
      allow create: if isStaff() || request.resource.data.value == 1;
      allow update: if isStaff() || request.resource.data.value == resource.data.value + 1;
      allow delete: if isStaff();
    }

    // Bestellungen
    match /orders/{orderId} {
      // Gast darf seine EIGENE Bestellung (über die geheime ID) live verfolgen,
      // aber nicht die Liste aller Bestellungen abrufen.
      allow get: if true;
      allow list, update, delete: if isStaff();
      allow create: if request.resource.data.status == 'neu'
        && request.resource.data.tisch is int
        && request.resource.data.tisch >= 1
        && request.resource.data.tisch <= 999
        && request.resource.data.positionen is list
        && request.resource.data.positionen.size() > 0
        && request.resource.data.positionen.size() <= 60;
    }
  }
}
